{
  "name": "zoron-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "bun run build:icons && bun run build:assets && bun run build:app && bun run build:manifest",
    "build:app": "vite build",
		"build:icons": "bun ../common/scripts/generateIcons.ts",
		"build:assets": "bun ../common/scripts/generateStaticFiles.ts",
		"build:manifest": "bun ../common/scripts/buildManifest.ts",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
		"postinstall": "bun run build:assets",
    "start": "node build/index.js"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.10.0",
    "@auth/sveltekit": "1.7.4",
    "@fingerprintjs/fingerprintjs": "^4.6.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@internationalized/date": "^3.8.2",
    "@simplewebauthn/browser": "^11.0.0",
    "@simplewebauthn/server": "^13.1.2",
    "@simplewebauthn/types": "^12.0.0",
    "@supabase/supabase-js": "^2.55.0",
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/adapter-node": "^5.2.14",
    "@sveltejs/adapter-vercel": "^5.8.2",
    "@sveltejs/kit": "^2.29.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/vite": "^4.1.11",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.2.1",
    "@types/web-push": "^3.6.4",
    "@types/wicg-file-system-access": "^2023.10.6",
    "@types/xml2js": "^0.4.14",
    "autoprefixer": "^10.4.21",
    "bits-ui": "^1.8.0",
    "caniuse-lite": "^1.0.30001735",
    "chalk": "^5.5.0",
    "date-picker-svelte": "^2.16.0",
    "eslint-plugin-import": "^2.32.0",
    "firebase": "^11.10.0",
    "jsdom": "^25.0.1",
    "lodash": "^4.17.21",
    "lucide-svelte": "^0.487.0",
    "mongodb": "^6.18.0",
    "pdf2json": "^3.2.0",
    "posthog-js": "^1.260.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sharp": "^0.33.5",
    "svelte": "^5.38.1",
    "svelte-check": "^4.3.1",
    "svelte-fa": "^4.0.4",
    "svelte-french-toast": "^1.2.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "4.0.13",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^5.4.19",
    "web-push": "^3.6.7",
    "xml2js": "^0.6.2"
  }
}
