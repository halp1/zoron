{
  "name": "zoron-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "bun run build:icons && bun run build:assets && bun run build:app && bun run build:manifest",
    "build:app": "vite build",
    "build:icons": "bun ../common/scripts/generateIcons.ts",
    "build:assets": "bun ../common/scripts/generateStaticFiles.ts",
    "build:manifest": "bun ../common/scripts/buildManifest.ts",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "postinstall": "bun run build:assets",
    "start": "node build/index.js"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.1",
    "@auth/sveltekit": "1.7.4",
    "@dnd-kit-svelte/core": "^0.0.11",
    "@dnd-kit-svelte/sortable": "^0.0.11",
    "@fingerprintjs/fingerprintjs": "^4.6.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@internationalized/date": "^3.10.1",
    "@simplewebauthn/browser": "^11.0.0",
    "@simplewebauthn/server": "^13.2.2",
    "@simplewebauthn/types": "^12.0.0",
    "@supabase/supabase-js": "^2.90.1",
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/adapter-node": "^5.5.1",
    "@sveltejs/adapter-vercel": "^5.10.3",
    "@sveltejs/kit": "^2.50.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.17.23",
    "@types/node": "^24.10.9",
    "@types/web-push": "^3.6.4",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@types/xml2js": "^0.4.14",
    "autoprefixer": "^10.4.23",
    "bits-ui": "^1.8.0",
    "caniuse-lite": "^1.0.30001765",
    "chalk": "^5.6.2",
    "date-picker-svelte": "^2.17.0",
    "eslint-plugin-import": "^2.32.0",
    "firebase": "^11.10.0",
    "html2canvas": "^1.4.1",
    "jsdom": "^25.0.1",
    "lodash": "^4.17.21",
    "lucide-svelte": "^0.487.0",
    "mongodb": "^6.21.0",
    "pdf2json": "3.2.0",
    "posthog-js": "^1.328.0",
    "prettier": "^3.8.0",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sharp": "^0.33.5",
    "svelte": "^5.46.4",
    "svelte-check": "^4.3.5",
    "svelte-fa": "^4.0.4",
    "svelte-french-toast": "^1.2.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "4.0.13",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
